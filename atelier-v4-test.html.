
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ATELIER — Your Digital Closet</title>
<style>
:root{--bg:#f8f9fa;--ink:#202124;--gold:#ad916b;--muted:#73777c;--line:#e9eaec}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Arial,sans-serif}
header{background:white;border-bottom:1px solid var(--line);padding:21px max(22px,calc((100vw - 1120px)/2));display:flex;justify-content:space-between;align-items:center;gap:12px}
.brand{font:normal 24px Georgia,serif;letter-spacing:.25em}
header small{color:#898989;letter-spacing:.14em;font-size:10px}
button,select,input{font:inherit;border:1px solid #dfe0e3;padding:10px 12px;background:white;color:var(--ink);border-radius:9px;max-width:100%}
button{cursor:pointer}
button.primary{background:#202124;color:white;border-color:#202124;padding:13px 18px}
button:hover{opacity:.83}
button:disabled{opacity:.5;cursor:wait}
[hidden]{display:none!important}
.muted{color:var(--muted);font-size:13px;line-height:1.6}
.eyebrow{color:var(--gold);letter-spacing:.2em;font-size:11px;text-transform:uppercase;font-weight:bold}
.welcome{max-width:1120px;margin:auto;padding:85px 24px 110px;min-height:75vh;display:grid;grid-template-columns:1.15fr .85fr;align-items:center;gap:60px}
.welcome h1{font:normal clamp(45px,7vw,78px) Georgia,serif;line-height:1.1;margin:20px 0}
.welcome p{color:var(--muted);line-height:1.85;max-width:510px}
.welcome-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
.visual{background:#eeebe5;min-height:390px;border-radius:22px;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:12px;border:1px solid #e8e2d8;text-align:center;padding:25px}
.visual .monogram{font:normal 105px Georgia,serif;color:#b6a58c}
.visual span{font-size:11px;letter-spacing:.22em;color:#8c7c69}
.auth{max-width:450px;margin:70px auto 110px;background:white;padding:35px;border:1px solid var(--line);border-radius:18px}
.auth h1{font:normal 36px Georgia,serif}
.auth form{display:grid;gap:13px}
.auth input{width:100%}
.auth label{font-size:12px;color:var(--muted)}
.auth .links{display:flex;justify-content:space-between;gap:8px;margin-top:15px}
.linkbtn{border:0;background:transparent;text-decoration:underline;padding:6px;color:#69635d}
.hero{max-width:1120px;margin:auto;padding:60px 24px 35px}
.hero h1{font:normal clamp(38px,7vw,60px) Georgia,serif;margin:14px 0}
.hero p{color:var(--muted);max-width:550px;line-height:1.7;margin:0}
.wrap{max-width:1120px;margin:auto;padding:0 24px 80px;display:grid;grid-template-columns:200px minmax(0,1fr);gap:24px}
.sidebar,.panel{background:white;border:1px solid var(--line);border-radius:18px}
.sidebar{padding:20px 13px;align-self:start}
.side-title{color:#999;letter-spacing:.16em;font-size:10px;margin:5px 12px 18px}
.nav{padding:13px;border-radius:10px;font-size:13px;color:#777;margin-bottom:5px}
.nav.active{background:#f7f4ef;color:#252525;font-weight:bold}
.side-note{font-size:12px;color:#999;line-height:1.6;margin:25px 12px 0;border-top:1px solid var(--line);padding-top:20px}
.panel{padding:28px}
.sectiontop{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.sectiontop h2{font:normal 30px Georgia,serif;margin:8px 0}
.upload{display:flex;align-items:center;gap:17px;border:1px dashed #cbb99e;border-radius:14px;padding:24px;cursor:pointer;margin:25px 0;background:#fdfcfb}
.upload-icon{display:grid;place-items:center;flex:none;width:48px;height:48px;background:#f5eee5;border-radius:12px;font-size:28px;color:#ab8d67}
.upload strong{display:block;font-size:15px;margin-bottom:5px}
.upload input{display:none}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(185px,1fr));gap:16px;margin-top:24px}
.item{border:1px solid var(--line);border-radius:14px;background:#fff;overflow:hidden}
.item img{display:block;width:100%;height:190px;object-fit:cover;background:#f3f4f5}
.itembody{padding:12px;display:grid;gap:9px}
.itembody input,.itembody select{width:100%;font-size:13px}
.itembody .actions{display:flex;gap:7px;flex-wrap:wrap}
.itembody button{font-size:11px;padding:8px}
.empty{padding:35px;text-align:center;color:#777;border:1px dashed var(--line);border-radius:14px;margin-top:22px}
.outfit{margin-top:30px;padding:24px;background:#faf8f5;border:1px solid #f0e9df;border-radius:14px}
.outfit h3{font:normal 23px Georgia,serif;margin:0 0 8px}
.outfit-grid{display:flex;gap:12px;flex-wrap:wrap}
.outfit-grid figure{width:125px;margin:0}
.outfit-grid img{width:125px;height:135px;object-fit:cover;border-radius:9px}
.outfit-grid figcaption{font-size:12px}
.notice{font-size:12px;color:#898989;margin-top:25px;padding-top:18px;border-top:1px solid var(--line);line-height:1.6}
footer{text-align:center;padding:30px;color:#999;font-size:12px}
.toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.photo-count{font-size:12px;color:#777}
#message{max-width:1120px;margin:15px auto;padding:0 24px;color:#986b36;font-size:13px;min-height:18px}
@media(max-width:750px){
.welcome{display:block;padding:55px 24px}
.visual{margin-top:40px;min-height:230px}
.wrap{display:block}
.sidebar{display:flex;gap:6px;overflow:auto;padding:8px;margin-bottom:15px}
.side-title,.side-note{display:none}
.nav{white-space:nowrap;margin:0}
.hero{padding:42px 20px 30px}
}
@media(max-width:550px){
.panel{padding:18px}
.wrap{padding:0 14px 60px}
.hero{padding:38px 17px 28px}
.item img{height:150px}
.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.itembody{padding:8px}
.upload{padding:15px}
.upload-icon{width:40px;height:40px}
header{padding:18px}
.auth{margin:30px 15px 70px;padding:24px}
}
</style>
</head>
<body>

<header>
<span class="brand">ATELIER</span>
<small>YOUR PERSONAL WARDROBE</small>
</header>

<div id="message" role="status" aria-live="polite"></div>

<section id="welcome" class="welcome">
<div>
<div class="eyebrow">Your style, all in one place</div>
<h1>Your closet,<br>reimagined.</h1>
<p>A beautiful home for everything you wear. Curate your collection, explore new combinations, and make every outfit feel effortless.</p>
<div class="welcome-actions">
<button class="primary" id="welcomeSignup">Create an account</button>
<button id="welcomeLogin">Log in</button>
<button id="welcomeDemo">Explore demo</button>
</div>
<p class="muted">Try it free. No account required for demo mode.</p>
</div>
<div class="visual" aria-hidden="true">
<div class="monogram">A</div>
<span>THE ART OF GETTING DRESSED</span>
</div>
</section>

<section id="authView" class="auth" hidden>
<div class="eyebrow">WELCOME TO ATELIER</div>
<h1 id="authTitle">Log in</h1>
<form id="authForm">
<label for="email">Email address</label>
<input id="email" type="email" autocomplete="email" required placeholder="you@example.com">
<div id="passwordWrap">
<label for="password">Password</label>
<input id="password" type="password" autocomplete="current-password" minlength="8" required placeholder="At least 8 characters">
</div>
<button class="primary" type="submit" id="authSubmit">Log in</button>
</form>
<div class="links">
<button class="linkbtn" id="authSwitch">Create account</button>
<button class="linkbtn" id="forgotBtn">Forgot password?</button>
</div>
<div class="links">
<button class="linkbtn" id="authBack">← Back to welcome</button>
</div>
</section>

<div id="closetView" hidden>
<section class="hero">
<div class="eyebrow" id="closetEyebrow">Your style, all in one place</div>
<h1>Your closet, reimagined.</h1>
<p>Every piece you own. Endless ways to wear it. Build your collection, explore your style, and make getting dressed feel effortless.</p>
</section>

<main class="wrap">
<aside class="sidebar">
<div class="side-title">YOUR SPACE</div>
<div class="nav active">My wardrobe</div>
<div class="nav">Outfit studio · soon</div>
<div class="nav">My style · soon</div>
<div class="side-note" id="sideNote"></div>
<button id="exitBtn" style="margin:18px 10px 0;font-size:12px">Exit</button>
</aside>

<div class="panel">
<div class="sectiontop">
<div>
<div class="eyebrow">THE COLLECTION</div>
<h2>My wardrobe</h2>
<div class="muted" id="count"></div>
</div>
<button class="primary" id="styleBtn">✦ Create an outfit</button>
</div>

<label class="upload">
<span class="upload-icon">+</span>
<span>
<strong>Add something to your closet</strong>
<span class="muted">Select front and back photos together to save them as one item</span>
</span>
<input id="photos" type="file" accept="image/jpeg,image/png,image/webp" multiple>
</label>

<div class="toolbar">
<select id="filter" aria-label="Filter clothing">
<option value="all">All clothing</option>
<option value="top">Tops</option>
<option value="bottom">Bottoms</option>
<option value="shoes">Shoes</option>
<option value="outerwear">Outerwear</option>
<option value="accessory">Accessories</option>
</select>
<span class="muted">Edit item names and categories anytime.</span>
</div>

<div id="items" class="grid"></div>
<div id="empty" class="empty">Your collection is waiting. Add your first piece above.</div>
<div id="outfit" class="outfit" hidden></div>
<div class="notice" id="closetNotice"></div>
</div>
</main>
</div>

<footer>ATELIER © 2026 · YOUR STYLE, YOUR RULES</footer>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
<script>
'use strict';

const SUPABASE_URL='https://xlwcllbgfmddfmgqtbgm.supabase.co';
const SUPABASE_KEY='sb_publishable_5U0q0LyAqWvVZKNXRmDT8g_TM-0cWnI';
const client=window.supabase?.createClient(SUPABASE_URL,SUPABASE_KEY);

const DEMO_KEY='atelier-demo-v1';
const CATS=['top','bottom','shoes','outerwear','accessory'];

const TYPES={
hoodie:['Hoodie','outerwear'],
crewneck:['Crewneck sweatshirt','top'],
sweatshirt:['Sweatshirt','top'],
tshirt:['T-shirt','top'],
shirt:['Shirt','top'],
jeans:['Jeans','bottom'],
cargo:['Cargo pants','bottom'],
pants:['Pants','bottom'],
shorts:['Shorts','bottom'],
jacket:['Jacket','outerwear'],
coat:['Coat','outerwear'],
sneakers:['Sneakers','shoes'],
shoes:['Shoes','shoes'],
hat:['Hat','accessory']
};

const $=id=>document.getElementById(id);
let mode='welcome';
let authMode='login';
let user=null;
let clothes=[];
let photoUrls={};
let busy=false;

function msg(text){
$('message').textContent=text||'';
}

function show(view){
for(const id of ['welcome','authView','closetView']){
$(id).hidden=id!==view;
}
msg('');
window.scrollTo(0,0);
}

function setAuth(next){
authMode=next;
show('authView');

$('authTitle').textContent=
next==='signup'?'Create your account':
next==='reset'?'Reset your password':
next==='recovery'?'Choose a new password':'Welcome back';

$('authSubmit').textContent=
next==='signup'?'Sign up':
next==='reset'?'Send reset email':
next==='recovery'?'Update password':'Log in';

$('passwordWrap').hidden=next==='reset';
$('password').required=next!=='reset';
$('email').disabled=next==='recovery';
$('authSwitch').textContent=
next==='signup'?'Already have an account? Log in':'Create account';
$('forgotBtn').hidden=next==='reset'||next==='recovery';
$('authSwitch').hidden=next==='recovery';
}

$('welcomeSignup').onclick=()=>setAuth('signup');
$('welcomeLogin').onclick=()=>setAuth('login');
$('welcomeDemo').onclick=()=>openCloset('demo');
$('authSwitch').onclick=()=>setAuth(authMode==='signup'?'login':'signup');
$('forgotBtn').onclick=()=>setAuth('reset');
$('authBack').onclick=()=>show('welcome');

$('authForm').onsubmit=async event=>{
event.preventDefault();

if(!client){
msg('Account service unavailable. Please refresh.');
return;
}

const email=$('email').value.trim();
const password=$('password').value;
const button=$('authSubmit');
button.disabled=true;

try{
let result;

if(authMode==='signup'){
result=await client.auth.signUp({
email,password,
options:{emailRedirectTo:location.origin+location.pathname}
});
}else if(authMode==='login'){
result=await client.auth.signInWithPassword({email,password});
}else if(authMode==='reset'){
result=await client.auth.resetPasswordForEmail(email,{
redirectTo:location.origin+location.pathname
});
}else{
result=await client.auth.updateUser({password});
}

if(result.error)throw result.error;

if(authMode==='signup'){
msg('Check your email to confirm your account, then log in.');
}else if(authMode==='reset'){
msg('If your email is registered, a reset link is on its way.');
}else if(authMode==='recovery'){
setAuth('login');
msg('Password updated. You can now log in.');
}else if(result.data.user){
user=result.data.user;
await openCloset('cloud');
}

}catch(error){
msg(error.message||'Something went wrong.');
}finally{
button.disabled=false;
}
};

function demoLoad(){
try{
const data=JSON.parse(localStorage.getItem(DEMO_KEY)||'[]');
return Array.isArray(data)?data:[];
}catch{
return [];
}
}

function demoSave(){
try{
localStorage.setItem(DEMO_KEY,JSON.stringify(clothes));
return true;
}catch{
return false;
}
}

async function openCloset(next){
mode=next;
photoUrls={};
$('filter').value='all';
$('outfit').hidden=true;

if(next==='demo'){
clothes=demoLoad();
$('closetEyebrow').textContent='DEMO / YOUR PLAYGROUND';
$('sideNote').textContent='Demo photos stay in this browser. Create an account to start a private cloud wardrobe.';
$('closetNotice').textContent='Demo mode: images are stored in this browser only. Your existing ATELIER wardrobe is untouched. Demo items do not automatically transfer to an account.';
$('exitBtn').textContent='Leave demo';
}else{
if(!user){
setAuth('login');
return;
}
clothes=[];
$('closetEyebrow').textContent='YOUR PRIVATE COLLECTION';
$('sideNote').textContent='Signed in as '+user.email;
$('closetNotice').textContent='Your account wardrobe is stored privately in Supabase. Existing browser-only ATELIER items have not yet been imported.';
$('exitBtn').textContent='Log out';
}

show('closetView');
render();

if(next==='cloud')await loadCloud();
}

$('exitBtn').onclick=async()=>{
if(mode==='cloud'&&client){
const {error}=await client.auth.signOut();
if(error){
msg(error.message);
return;
}
user=null;
}
mode='welcome';
clothes=[];
photoUrls={};
show('welcome');
};

function infer(name){
const value=name.toLowerCase().replace(/[^a-z]/g,'');
for(const [key,result] of Object.entries(TYPES)){
if(value.includes(key))return result;
}
return ['Uncategorized','top'];
}

async function loadCloud(){
const {data,error}=await client
.from('wardrobe_items')
.select('*')
.eq('user_id',user.id)
.order('created_at',{ascending:false});

if(error){
msg('Could not load wardrobe: '+error.message);
return;
}

clothes=data||[];
await refreshUrls();
render();
}

async function refreshUrls(){
photoUrls={};

const paths=[
...new Set(
clothes.flatMap(item=>Array.isArray(item.photos)?item.photos:[])
)
];

await Promise.all(paths.map(async path=>{
if(typeof path!=='string'||!path.startsWith(user.id+'/'))return;

const {data}=await client.storage
.from('wardrobe-photos')
.createSignedUrl(path,3600);

if(data?.signedUrl)photoUrls[path]=data.signedUrl;
}));
}

function photoSrc(path){
return mode==='cloud'?photoUrls[path]||'':path;
}

function optionSelect(values,selected,change){
const select=document.createElement('select');

values.forEach(([value,label])=>{
const option=document.createElement('option');
option.value=value;
option.textContent=label;
select.append(option);
});

select.value=selected;
select.onchange=()=>change(select.value);
return select;
}

async function updatePiece(piece,patch){
if(mode==='demo'){
Object.assign(piece,patch);
if(!demoSave())msg('Browser storage full.');
return;
}

const {error}=await client
.from('wardrobe_items')
.update(patch)
.eq('id',piece.id)
.eq('user_id',user.id);

if(error){
msg(error.message);
await loadCloud();
}else{
Object.assign(piece,patch);
}
}

function render(){
const root=$('items');
root.replaceChildren();

$('count').textContent=
`${clothes.length} piece${clothes.length===1?'':'s'} in your collection`;

const shown=clothes.filter(item=>
$('filter').value==='all'||item.category===$('filter').value
);

$('empty').hidden=shown.length>0;

shown.forEach(piece=>{
const card=document.createElement('article');
card.className='item';

const img=document.createElement('img');
img.src=photoSrc(piece.photos?.[piece.photoIndex||0]||piece.photos?.[0]||piece.image)||'';
img.alt=piece.name||'Clothing item';

const body=document.createElement('div');
body.className='itembody';

const name=document.createElement('input');
name.type='text';
name.value=piece.name||'';
name.maxLength=50;
name.setAttribute('aria-label','Item name');
name.onchange=()=>updatePiece(piece,{
name:name.value.trim()||'Clothing item'
});

const type=document.createElement('input');
type.type='text';
type.value=piece.type||'Uncategorized';
type.maxLength=40;
type.setAttribute('aria-label','Clothing type');
type.onchange=()=>updatePiece(piece,{
type:type.value.trim()||'Uncategorized'
});

const cat=optionSelect(
CATS.map(c=>[c,c[0].toUpperCase()+c.slice(1)]),
piece.category,
value=>updatePiece(piece,{category:value}).then(render)
);

cat.setAttribute('aria-label','Category');

const count=document.createElement('span');
count.className='photo-count';
count.textContent=`${piece.photos?.length||0} photo(s)`;

const actions=document.createElement('div');
actions.className='actions';

const next=document.createElement('button');
next.textContent='Next photo';
next.onclick=()=>{
const photos=piece.photos||[];
if(!photos.length)return;
piece.photoIndex=((piece.photoIndex||0)+1)%photos.length;
img.src=photoSrc(photos[piece.photoIndex]);
};

const add=document.createElement('button');
add.textContent='+ Photo';

const file=document.createElement('input');
file.type='file';
file.accept='image/jpeg,image/png,image/webp';
file.hidden=true;

file.onchange=async()=>{
if(!file.files[0]||busy)return;
busy=true;

try{
const photo=await resize(file.files[0]);

if(mode==='demo'){
const previous=[...(piece.photos||[])];
piece.photos=[...previous,photo];

if(!demoSave()){
piece.photos=previous;
throw Error('Browser storage full.');
}
}else{
const path=await uploadPhoto(photo);
const photos=[...(piece.photos||[]),path];

const {error}=await client
.from('wardrobe_items')
.update({photos})
.eq('id',piece.id)
.eq('user_id',user.id);

if(error){
await client.storage.from('wardrobe-photos').remove([path]);
throw error;
}

piece.photos=photos;
await refreshUrls();
}

render();
}catch(error){
msg(error.message||'Could not add photo.');
}finally{
busy=false;
}
};

add.onclick=()=>file.click();

const del=document.createElement('button');
del.textContent='Remove';

del.onclick=async()=>{
if(!confirm('Remove this clothing item?'))return;

if(mode==='demo'){
const previous=clothes;
clothes=clothes.filter(item=>item.id!==piece.id);

if(!demoSave()){
clothes=previous;
msg('Could not save change.');
}

render();
return;
}

const {error}=await client
.from('wardrobe_items')
.delete()
.eq('id',piece.id)
.eq('user_id',user.id);

if(error){
msg(error.message);
return;
}

const paths=(piece.photos||[]).filter(path=>
typeof path==='string'&&path.startsWith(user.id+'/')
);

if(paths.length){
await client.storage.from('wardrobe-photos').remove(paths);
}

await loadCloud();
};

actions.append(next,add,del,file);
body.append(name,type,cat,count,actions);
card.append(img,body);
root.append(card);
});
}

function resize(file){
return new Promise((resolve,reject)=>{
const reader=new FileReader();
reader.onerror=reject;

reader.onload=()=>{
const img=new Image();
img.onerror=reject;

img.onload=()=>{
const max=600;
const scale=Math.min(1,max/Math.max(img.width,img.height));
const canvas=document.createElement('canvas');

canvas.width=Math.max(1,Math.round(img.width*scale));
canvas.height=Math.max(1,Math.round(img.height*scale));

canvas.getContext('2d').drawImage(
img,0,0,canvas.width,canvas.height
);

resolve(canvas.toDataURL('image/jpeg',.7));
};

img.src=reader.result;
};

reader.readAsDataURL(file);
});
}

async function uploadPhoto(dataUrl){
const blob=await(await fetch(dataUrl)).blob();
const path=user.id+'/'+crypto.randomUUID()+'.jpg';

const {error}=await client.storage
.from('wardrobe-photos')
.upload(path,blob,{
contentType:'image/jpeg',
upsert:false
});

if(error)throw error;
return path;
}

$('photos').onchange=async event=>{
const files=[...event.target.files].filter(file=>
['image/jpeg','image/png','image/webp'].includes(file.type)
);

event.target.value='';
if(!files.length||busy)return;

busy=true;
msg('Adding item…');

let paths=[];

try{
const photos=await Promise.all(files.map(resize));
const [type,category]=infer(files[0].name);
const name=files[0].name.replace(/\.[^.]+$/,'').slice(0,50)||'Clothing item';

if(mode==='demo'){
const piece={
id:crypto.randomUUID(),
name,type,category,photos
};

clothes.push(piece);

if(!demoSave()){
clothes.pop();
throw Error('Browser storage full. Try fewer photos.');
}

render();
}else{
for(const photo of photos){
paths.push(await uploadPhoto(photo));
}

const {error}=await client
.from('wardrobe_items')
.insert({
user_id:user.id,
name,type,category,
photos:paths
});

if(error)throw error;

await loadCloud();
}

msg('');
}catch(error){
if(paths.length&&mode==='cloud'){
await client.storage.from('wardrobe-photos').remove(paths);
}
msg(error.message||'Could not read photos.');
}finally{
busy=false;
}
};

$('filter').onchange=render;

$('styleBtn').onclick=()=>{
const chosen=CATS.map(category=>{
const options=clothes.filter(item=>item.category===category);
return options[Math.floor(Math.random()*options.length)];
}).filter(Boolean);

const root=$('outfit');
root.hidden=false;
root.replaceChildren();

const heading=document.createElement('h3');
heading.textContent=chosen.length?'Your outfit edit':'Start your collection';
root.append(heading);

if(!chosen.length){
const p=document.createElement('p');
p.textContent='Add some clothing first.';
root.append(p);
return;
}

const grid=document.createElement('div');
grid.className='outfit-grid';

chosen.forEach(item=>{
const figure=document.createElement('figure');
const img=document.createElement('img');
const caption=document.createElement('figcaption');

img.src=photoSrc(item.photos?.[0]||item.image);
img.alt=item.name;
caption.textContent=item.type||item.name;

figure.append(img,caption);
grid.append(figure);
});

root.append(grid);

const note=document.createElement('p');
note.className='muted';
note.textContent='Random outfit preview. AI styling is not connected yet.';
root.append(note);
};

(async()=>{
if(!client){
msg('Account service unavailable. Demo mode still works.');
return;
}

client.auth.onAuthStateChange((event,session)=>{
if(event==='PASSWORD_RECOVERY'){
user=session?.user||null;
setAuth('recovery');
}
});

const {data:{session}}=await client.auth.getSession();

if(session?.user){
user=session.user;
await openCloset('cloud');
}
})();
</script>
